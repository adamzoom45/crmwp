<?php
/**
 * АКПП45 CRM — Автономный почтовый модуль v3.
 * Собственная реализация SMTP/IMAP поверх stream_socket_client().
 * НЕ использует wp_mail(), PHPMailer, SwiftMailer или любую внешнюю библиотеку.
 * Работает только на нашем сервере, полностью независим от окружения WP.
 *
 * @package AKPP_CRM
 * @version 5.1.2
 */
if (!defined('ABSPATH')) exit;

class AKPP_Mail {
    private static $instance = null;
    public static function get_instance() { if (null === self::$instance) self::$instance = new self(); return self::$instance; }

    private function __construct() {
        add_action('admin_menu', [$this, 'add_menu']);
        add_action('admin_post_akpp_mail_save', [$this, 'handle_save']);
        add_action('admin_post_akpp_mail_test_send', [$this, 'handle_test_send']);
        add_action('admin_post_akpp_mail_test_recv', [$this, 'handle_test_recv']);
        add_filter('cron_schedules', [$this, 'add_intervals']);
        add_action('wp', [$this, 'schedule']);
        add_action('akpp_mail_queue_process', [$this, 'process_queue']);
        add_action('akpp_mail_inbox_poll', [$this, 'poll_inbox']);
    }

    // ═══════════════════════════════════════
    // КОНФИГУРАЦИЯ
    // ═══════════════════════════════════════
    public static function cfg($k = '', $d = '') {
        $o = (array) get_option('akpp_mail_cfg', []);
        if ($k === '') return $o;
        return isset($o[$k]) && $o[$k] !== '' ? $o[$k] : $d;
    }

    public function add_intervals($s) {
        if (!isset($s['akpp_every_5min'])) $s['akpp_every_5min'] = ['interval' => 300, 'display' => 'Каждые 5 минут'];
        if (!isset($s['akpp_every_15min'])) $s['akpp_every_15min'] = ['interval' => 900, 'display' => 'Каждые 15 минут'];
        return $s;
    }

    public function schedule() {
        if (!wp_next_scheduled('akpp_mail_queue_process')) wp_schedule_event(time() + 60, 'akpp_every_5min', 'akpp_mail_queue_process');
        if (!wp_next_scheduled('akpp_mail_inbox_poll')) wp_schedule_event(time() + 120, 'akpp_every_15min', 'akpp_mail_inbox_poll');
    }

    // ═══════════════════════════════════════
    // СОБСТВЕННЫЙ SMTP-КЛИЕНТ (stream_socket_client)
    // ═══════════════════════════════════════

    /** Отправить письмо напрямую через SMTP. Возвращает true/false + error_log при ошибке. */
    public function smtp_send($to, $subject, $body, $html = false, $attachments = []) {
        $host = self::cfg('send_host');
        $port = (int) self::cfg('send_port', '587');
        $user = self::cfg('send_user');
        $pass = self::cfg('send_pass');
        $enc  = self::cfg('send_encryption', 'tls');
        $from = self::cfg('send_from_email') ?: $user;
        $fname = self::cfg('send_from_name');

        if ($host === '' || $user === '' || $pass === '') {
            error_log('[AKPP_MAIL] smtp_send: не настроены host/user/pass');
            return false;
        }

        // Соединение
        $ctx = ['ssl' => ['verify_peer' => false, 'verify_peer_name' => false]];
        $prefix = ($enc === 'ssl') ? 'ssl://' : '';
        $socket = @stream_socket_client($prefix . $host . ':' . $port, $errno, $errstr, 30, STREAM_CLIENT_CONNECT, stream_context_create($ctx));
        if (!$socket) {
            error_log("[AKPP_MAIL] connect fail: $host:$port — $errstr ($errno)");
            return false;
        }
        stream_set_timeout($socket, 30);

        $log = [];
        $read = function () use ($socket, &$log) {
            $data = '';
            while ($line = fgets($socket, 512)) {
                $data .= $line;
                if (substr($line, 3, 1) === ' ') break;
            }
            $log[] = trim($data);
            return $data;
        };
        $write = function ($cmd) use ($socket, &$log) {
            fwrite($socket, $cmd . "\r\n");
            $log[] = '> ' . trim($cmd);
        };

        try {
            $read(); // greeting 220
            $write("EHLO " . php_uname('n'));
            $ehlo_resp = $read();

            // STARTTLS если нужно
            if ($enc === 'tls' && strpos($ehlo_resp, '250-STARTTLS') !== false) {
                $write("STARTTLS");
                $read(); // 220 Ready to start TLS
                $crypto = stream_socket_enable_crypto($socket, true, STREAM_CRYPTO_METHOD_TLSv1_2_CLIENT | STREAM_CRYPTO_METHOD_TLSv1_3_CLIENT);
                if (!$crypto) throw new Exception('STARTTLS failed');
                $write("EHLO " . php_uname('n'));
                $read();
            } elseif ($enc === 'tls' && strpos($ehlo_resp, '250-STARTTLS') === false) {
                // Сервер не поддерживает STARTTLS, пробуем как есть
                error_log('[AKPP_MAIL] server does not support STARTTLS, proceeding without');
            }

            // AUTH LOGIN
            $write("AUTH LOGIN");
            $read(); // 334 VXNlcm5hbWU6
            $write(base64_encode($user));
            $read(); // 334 UGFzc3dvcmQ6
            $write(base64_encode($pass));
            $auth_resp = $read(); // 235 Authentication successful
            if (strpos($auth_resp, '235') === false) throw new Exception('AUTH failed: ' . trim($auth_resp));

            // MAIL FROM
            $write("MAIL FROM:<$from>");
            $read(); // 250 OK

            // RCPT TO
            $recipients = array_map('trim', explode(',', $to));
            foreach ($recipients as $rcpt) {
                $write("RCPT TO:<$rcpt>");
                $read(); // 250 or 251
            }

            // DATA
            $write("DATA");
            $read(); // 354 Start mail input

            $boundary = '----=_Part_' . md5(uniqid(mt_rand(), true));
            $headers = [
                'From: ' . ($fname ? "$fname <$from>" : $from),
                'To: ' . $to,
                'Subject: ' . $this->encode_header($subject),
                'Date: ' . date('r'),
                'Message-ID: <' . uniqid('akpp_', true) . '@' . $host . '>',
                'MIME-Version: 1.0',
            ];
            if ($html) {
                $headers[] = 'Content-Type: multipart/alternative; boundary="' . $boundary . '"';
            } else {
                $headers[] = 'Content-Type: text/plain; charset=UTF-8';
                $headers[] = 'Content-Transfer-Encoding: base64';
            }

            $msg = implode("\r\n", $headers) . "\r\n\r\n";
            if ($html) {
                $plain_ver = strip_tags(str_replace('<br>', "\n", $body));
                $msg .= "--$boundary\r\nContent-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n" . chunk_split(base64_encode($plain_ver)) . "\r\n";
                $msg .= "--$boundary\r\nContent-Type: text/html; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n" . chunk_split(base64_encode($body)) . "\r\n";
                $msg .= "--$boundary--\r\n";
            } else {
                $msg .= chunk_split(base64_encode($body)) . "\r\n";
            }
            $msg .= ".\r\n";
            fwrite($socket, $msg);
            $data_resp = $read(); // 250 OK queued

            $write("QUIT");
            fclose($socket);

            if (strpos($data_resp, '250') !== false) return true;
            throw new Exception('DATA rejected: ' . trim($data_resp));

        } catch (Exception $e) {
            error_log('[AKPP_MAIL] smtp error: ' . $e->getMessage());
            if (is_resource($socket)) fclose($socket);
            return false;
        }
    }

    private function encode_header($str) {
        if (preg_match('/[^\x20-\x7E]/', $str)) {
            return '=?UTF-8?B?' . base64_encode($str) . '?=';
        }
        return $str;
    }

    // ═══════════════════════════════════════
    // ОЧЕРЕДЬ ОТРАВКИ
    // ═══════════════════════════════════════
    public function queue($to, $subject, $body, $html = false) {
        global $wpdb;
        $t = $wpdb->prefix . 'akpp_mail_queue';
        if ($wpdb->get_var("SHOW TABLES LIKE '$t'") !== $t) $this->ensure_tables();
        $wpdb->insert($t, [
            'recipient' => sanitize_text_field($to),
            'subject'   => sanitize_text_field($subject),
            'body'      => $body,
            'is_html'   => $html ? 1 : 0,
            'status'    => 'pending',
            'attempts'  => 0,
            'created_at'=> current_time('mysql'),
        ]);
        return (int) $wpdb->insert_id;
    }

    public function process_queue() {
        global $wpdb;
        $t = $wpdb->prefix . 'akpp_mail_queue';
        if ($wpdb->get_var("SHOW TABLES LIKE '$t'") !== $t) return;
        $rows = $wpdb->get_results("SELECT * FROM $t WHERE status='pending' AND attempts < 5 ORDER BY id ASC LIMIT 10");
        foreach ($rows as $r) {
            $ok = $this->smtp_send($r->recipient, $r->subject, $r->body, (bool) $r->is_html);
            if ($ok) {
                $wpdb->update($t, ['status' => 'sent', 'sent_at' => current_time('mysql')], ['id' => $r->id]);
            } else {
                $wpdb->update($t, ['status' => 'failed', 'attempts' => $r->attempts + 1, 'error' => 'SMTP fail'], ['id' => $r->id]);
            }
        }
    }

    // ═══════════════════════════════════════
    // СОБСТВЕННЫЙ IMAP-КЛИЕНТ (stream_socket_client)
    // ═══════════════════════════════════════
    public function poll_inbox() {
        if (self::cfg('recv_enabled') !== '1') return;
        $host = self::cfg('recv_host');
        if ($host === '') return;
        $port = (int) self::cfg('recv_port', '993');
        $user = self::cfg('recv_user');
        $pass = self::cfg('recv_pass');
        $enc  = self::cfg('recv_encryption', 'ssl');
        $folder = self::cfg('recv_folder', 'INBOX');

        $ctx = ['ssl' => ['verify_peer' => false, 'verify_peer_name' => false]];
        $prefix = ($enc === 'ssl') ? 'ssl://' : '';
        $sock = @stream_socket_client($prefix . $host . ":$port", $errno, $errstr, 30, STREAM_CLIENT_CONNECT, stream_context_create($ctx));
        if (!$sock) { error_log("[AKPP_MAIL] IMAP connect fail: $host:$port — $errstr"); return; }
        stream_set_timeout($sock, 30);

        $tag = 0;
        $imap_cmd = function ($cmd) use ($sock, &$tag) {
            $t = 'A' . str_pad(++$tag, 4, '0', STR_PAD_LEFT);
            fwrite($sock, "$t $cmd\r\n");
            $resp = '';
            while ($line = fgets($sock, 4096)) {
                $resp .= $line;
                if (strpos($line, "$t ") === 0) break;
            }
            return $resp;
        };
        $imap_read_until_tag = function ($expected_tag) use ($sock) {
            $buf = '';
            while ($line = fgets($sock, 4096)) {
                $buf .= $line;
                if (strpos($line, "$expected_tag ") === 0) break;
            }
            return $buf;
        };

        try {
            // Greeting
            $greet = fgets($sock, 4096);
            if (strpos($greet, '* OK') === false && strpos($greet, '+OK') === false) throw new Exception('Bad greeting');

            // LOGIN
            $login = $imap_cmd("LOGIN \"$user\" \"$pass\"");
            if (strpos($login, 'OK') === false) throw new Exception('Login failed');

            // SELECT folder
            $sel = $imap_cmd("SELECT \"$folder\"");
            if (strpos($sel, 'OK') === false) throw new Exception("Select $folder failed");

            // SEARCH UNSEEN (последние 20)
            $search = $imap_cmd("SEARCH UNSEEN");
            preg_match('/\* SEARCH (.+)/', $search, $m);
            $ids = array_slice(array_reverse(explode(' ', trim($m[1] ?? ''))), 0, 20);

            global $wpdb;
            $seen_t = $wpdb->prefix . 'akpp_mail_seen';
            $leads_t = $wpdb->prefix . 'akpp_leads';
            $chat_t  = $wpdb->prefix . 'akpp_chat_messages';
            if ($wpdb->get_var("SHOW TABLES LIKE '$seen_t'") !== $seen_t) $this->ensure_tables();

            $processed = 0;
            foreach ($ids as $num) {
                if ((int) $num <= 0) continue;
                // FETCH headers
                $fetch = $imap_cmd("FETCH $num (BODY.PEEK[HEADER.FIELDS (FROM SUBJECT MESSAGE-ID)])");
                preg_match('/From: (.+?)@(.+?)[>\n]/i', $fetch, $fm);
                $from_addr = strtolower(($fm[1] ?? '') . '@' . ($fm[2] ?? ''));
                preg_match('/Subject: (.+?)(?:\r?\n|$)/i', $fetch, $sm);
                $subject = trim($sm[1] ?? '');
                preg_match('/Message-ID: (<.+?>)/i', $fetch, $mm);
                $msg_id = trim($mm[1] ?? uniqid());

                // Анти-спам
                if ($this->is_spam($from_addr, $subject, $msg_id)) continue;

                // Уже видели?
                $exists = $wpdb->get_var($wpdb->prepare("SELECT id FROM $seen_t WHERE msg_id=%s", $msg_id));
                if ($exists) continue;
                $wpdb->insert($seen_t, ['msg_id' => $msg_id, 'from_addr' => $from_addr, 'received_at' => current_time('mysql')]);

                // FETCH body
                $fb = $imap_cmd("FETCH $num (BODY.PEEK[])");
                $body = $this->extract_imap_body($fb);

                // MARK AS SEEN
                $imap_cmd("STORE $num +FLAGS (\\Seen)");

                // Ингест
                $this->ingest_message($from_addr, $subject, $body);
                $processed++;
            }

            $imap_cmd("LOGOUT");
            fclose($sock);
            if ($processed > 0) error_log("[AKPP_MAIL] inbox: обработано $processed писем");
            return $processed;

        } catch (Exception $e) {
            error_log('[AKPP_MAIL] IMAP error: ' . $e->getMessage());
            if (is_resource($sock)) fclose($sock);
            return 0;
        }
    }

    private function extract_imap_body($raw) {
        // Извлекает тело из IMAP FETCH response (base64 или quoted-printable)
        if (preg_match('/\{(\d+)\}\r\n(.*)$/s', $raw, $m)) {
            $len = (int) $m[1];
            $chunk = substr($m[2], 0, $len);
        } else {
            $chunk = $raw;
        }
        // Декодируем base64 сегменты
        $decoded = '';
        if (preg_match_all('/[A-Za-z0-9+\/=\r\n]{40,}/', $chunk, $b64)) {
            foreach ($b64[0] as $seg) {
                $try = base64_decode(preg_replace('/\s/', '', $seg), true);
                if ($try !== false && strlen($try) > 10) $decoded .= $try;
            }
        }
        if ($decoded === '') $decoded = quoted_printable_decode($chunk);
        // Убираем HTML теги для plain-text обработки
        return strip_tags(html_entity_decode($decoded, ENT_QUOTES, 'UTF-8'));
    }

    // ═══════════════════════════════════════
    // АНТИ-СПАМ
    // ═══════════════════════════════════════
    private function is_spam($from_addr, $subject, $msg_id) {
        if ($from_addr === '' || strpos($from_addr, '@') === false) return true;

        // Чёрный список
        $bl = array_filter(array_map('trim', explode("\n", (string) self::cfg('blacklist'))));
        foreach ($bl as $p) {
            if ($p === '') continue;
            $pat = str_replace('*', '.*', preg_quote(ltrim($p, '*'), '/'));
            if (preg_match("/^$pat$/i", $from_addr)) return true;
        }

        // Rate-limit: макс 5/час/адрес
        global $wpdb;
        $seen_t = $wpdb->prefix . 'akpp_mail_seen';
        if ($wpdb->get_var("SHOW TABLES LIKE '$seen_t'") === $seen_t) {
            $recent = (int) $wpdb->get_var($wpdb->prepare(
                "SELECT COUNT(*) FROM $seen_t WHERE from_addr=%s AND received_at > DATE_SUB(NOW(), INTERVAL 1 HOUR)", $from_addr
            ));
            if ($recent >= 5) return true;
        }

        // Keyword filter
        $words = ['viagra','casino','lottery','free money','bitcoin giveaway','wire transfer urgent','make money fast'];
        $sl = strtolower($subject);
        foreach ($words as $w) { if (strpos($sl, $w) !== false) return true; }

        return false;
    }

    // ═══════════════════════════════════════
    // ИНГЕСТ: письмо → лид / ответ в чат
    // ═══════════════════════════════════════
    private function ingest_message($from_addr, $subject, $body) {
        global $wpdb;
        $leads_t = $wpdb->prefix . 'akpp_leads';
        $chat_t  = $wpdb->prefix . 'akpp_chat_messages';

        $lead = $wpdb->get_row($wpdb->prepare("SELECT id FROM $leads_t WHERE client_email=%s LIMIT 1", $from_addr));

        if ($lead && $wpdb->get_var("SHOW TABLES LIKE '$chat_t'") === $chat_t) {
            // Ответ в чат лида
            $cols = $wpdb->get_col("SHOW COLUMNS FROM $chat_t");
            $row = ['message_text' => mb_substr($body, 0, 5000)];
            if (in_array('dialog_id', $cols)) $row['dialog_id'] = $lead->id;
            if (in_array('sender_name', $cols)) $row['sender_name'] = $from_addr;
            if (in_array('created_at', $cols)) $row['created_at'] = current_time('mysql');
            $wpdb->insert($chat_t, $row);
        } else {
            // Новый лид
            $phone = preg_match('/\+?\d[\d\s\-()]{8,}/', $body, $pm) ? preg_replace('/\D/', '', $pm[0]) : '';
            $car = '';
            if (preg_match('/(Toyota|Nissan|Mazda|Honda|Hyundai|Kia|Mitsubishi|Subaru|Lexus)\s+\w+/iu', $body, $cm)) $car = $cm[0];
            $ins = [
                'client_name' => explode('@', $from_addr)[0],
                'client_phone' => $phone,
                'client_email' => $from_addr,
                'car_brand' => $car,
                'problem' => mb_substr($body, 0, 500),
                'status' => 'new',
                'source' => 'email-inbox',
                'created_at' => current_time('mysql'),
            ];
            $cols = $wpdb->get_col("SHOW COLUMNS FROM $leads_t");
            $filtered = array_intersect_key($ins, array_flip($cols));
            $wpdb->insert($leads_t, $filtered);
            // Уведомление менеджеру
            $mgr = self::cfg('notify_email') ?: get_option('admin_email');
            $this->queue($mgr, 'Новый лид из почты: ' . $from_addr, "Email: $from_addr\nТема: $subject\n\n$body");
        }
    }

    // ═══════════════════════════════════════
    // ТАБЛИЦЫ
    // ═══════════════════════════════════════
    private function ensure_tables() {
        global $wpdb;
        $charset = $wpdb->get_charset_collate();
        $P = $wpdb->prefix;
        $sqls = [
            "CREATE TABLE IF NOT EXISTS {$P}akpp_mail_queue (
                id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
                recipient VARCHAR(255) NOT NULL, subject VARCHAR(500) NOT NULL, body LONGTEXT,
                is_html TINYINT(1) DEFAULT 0,
                status VARCHAR(20) DEFAULT 'pending', attempts INT DEFAULT 0, error TEXT,
                created_at DATETIME DEFAULT CURRENT_TIMESTAMP, sent_at DATETIME DEFAULT NULL,
                PRIMARY KEY (id), KEY status (status)
            ) $charset",
            "CREATE TABLE IF NOT EXISTS {$P}akpp_mail_seen (
                id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
                msg_id VARCHAR(500) NOT NULL, from_addr VARCHAR(255) NOT NULL,
                received_at DATETIME DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (id), UNIQUE KEY msg_id (msg_id(191)), KEY from_addr (from_addr)
            ) $charset",
        ];
        foreach ($sqls as $sql) $wpdb->query($sql);
    }

    // ═══════════════════════════════════════
    // АДМИН
    // ═══════════════════════════════════════
    public function add_menu() {
        add_menu_page('Почта', '📧 Почта', 'manage_options', 'akpp-mail', [$this, 'render'], 'dashicons-email-alt', 57);
    }

    public function handle_save() {
        if (!current_user_can('manage_options')) wp_die('Недостаточно прав');
        check_admin_referer('akpp_mail');
        $keys = ['send_host','send_port','send_encryption','send_user','send_pass','send_from_email','send_from_name','notify_email',
                 'recv_enabled','recv_host','recv_port','recv_encryption','recv_user','recv_pass','recv_folder','blacklist'];
        $cfg = [];
        foreach ($keys as $k) if (isset($_POST[$k])) $cfg[$k] = sanitize_textarea_field(wp_unslash($_POST[$k]));
        update_option('akpp_mail_cfg', $cfg);
        $this->ensure_tables();
        wp_safe_redirect(admin_url('admin.php?page=akpp-mail&saved=1'));
        exit;
    }

    public function handle_test_send() {
        if (!current_user_can('manage_options')) wp_die('Недостаточно прав');
        check_admin_referer('akpp_mail');
        $to = self::cfg('notify_email') ?: get_option('admin_email');
        $ok = $this->smtp_send($to, 'Тест SMTP — АКПП Mail Module (автономный)', 'Если видите это — собственный SMTP-клиент работает. Время: '.current_time('mysql'));
        wp_safe_redirect(admin_url('admin.php?page=akpp-mail&test_send='.($ok?'ok':'fail')));
        exit;
    }

    public function handle_test_recv() {
        if (!current_user_can('manage_options')) wp_die('Недостаточно прав');
        check_admin_referer('akpp_mail');
        $n = $this->poll_inbox();
        wp_safe_redirect(admin_url('admin.php?page=akpp-mail&test_recv='.$n));
        exit;
    }

    public function render() {
        $c = self::cfg();
        echo '<div class="wrap"><h1 style="color:#00ff88">📧 Почтовый модуль (автономный)</h1>';
        echo '<p style="color:#a0aec0;font-size:12px;margin-top:-10px">Собственный SMTP/IMAP клиент. Без wp_mail(), без PHPMailer, без внешних зависимостей.</p>';
        if (isset($_GET['saved'])) echo '<div class="notice notice-success"><p>✅ Сохранено.</p></div>';
        if (isset($_GET['test_send'])) echo '<div class="notice '.($_GET['test_send']==='ok'?'notice-success':'notice-error').'"><p>'.($_GET['test_send']==='ok'?'✅ Письмо отправлено собственным SMTP-клиентом.':'❌ Ошибка SMTP — проверьте хост/порт/логин/пароль.').'</p></div>';
        if (isset($_GET['test_recv'])) echo '<div class="notice notice-info"><p>ℹ️ Приём: обработано новых писем: '.(int)$_GET['test_recv'].'.</p></div>';

        global $wpdb;
        $qt = $wpdb->prefix.'akpp_mail_queue';
        if ($wpdb->get_var("SHOW TABLES LIKE '$qt'") === $qt) {
            $pending = $wpdb->get_var("SELECT COUNT(*) FROM $qt WHERE status='pending'") ?: 0;
            $sent = $wpdb->get_var("SELECT COUNT(*) FROM $qt WHERE status='sent'") ?: 0;
            $failed = $wpdb->get_var("SELECT COUNT(*) FROM $qt WHERE status='failed'") ?: 0;
            echo '<p style="color:#a0aec0">Очередь: ⏳ '.$pending.' · ✅ '.$sent.' · ❌ '.$failed.'</p>';
        }

        echo '<form method="post" action="'.esc_url(admin_url('admin-post.php')).'" style="max-width:860px">';
        wp_nonce_field('akpp_mail');
        echo '<input type="hidden" name="action" value="akpp_mail_save">';

        echo '<h2 style="color:#00ff88;border-bottom:1px solid #2d3748;padding-bottom:8px;margin-top:20px">📤 Отправка (собственный SMTP)</h2>';
        echo '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">';
        $f = function($k,$l,$ph='') use($c){ echo '<label style="color:#a0aec0;font-size:12px">'.esc_html($l).'<br><input type="text" name="'.$k.'" value="'.esc_attr($c[$k]??'').'" placeholder="'.esc_attr($ph).'" style="width:100%;margin-top:4px"></label>'; };
        $fp = function($k,$l) use($c){ echo '<label style="color:#a0aec0;font-size:12px">'.esc_html($l).'<br><input type="password" name="'.$k.'" value="'.esc_attr($c[$k]??'').'" style="width:100%;margin-top:4px"></label>'; };
        $f('send_host','SMTP-хост','smtp.mail.ru');
        $f('send_port','Порт','587');
        echo '<label style="color:#a0aec0;font-size:12px">Шифрование<br><select name="send_encryption" style="width:100%;margin-top:4px">';
        foreach(['tls'=>'STARTTLS (587)','ssl'=>'SSL (465)',''=>'нет (25)'] as $v=>$l) echo '<option value="'.esc_attr($v).'"'.selected(($c['send_encryption']??'tls'),$v,false).'>'.esc_html($l).'</option>';
        echo '</select></label>';
        $f('send_user','Логин','you@domain');
        $fp('send_pass','Пароль приложения');
        $f('send_from_email','From: email','alerts@ваш.домен');
        $f('send_from_name','From: имя','CRM');
        $f('notify_email','Уведомлять менеджера','admin@ваш.домен');
        echo '</div>';

        echo '<h2 style="color:#00ff88;border-bottom:1px solid #2d3748;padding-bottom:8px;margin-top:24px">📥 Приём (собственный IMAP)</h2>';
        echo '<label style="color:#a0aec0;font-size:12px;display:block;margin-bottom:10px"><input type="checkbox" name="recv_enabled" value="1"'.checked(self::cfg('recv_enabled'),'1',false).'> Включить приём (письма → лиды/чаты)</label>';
        echo '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">';
        $f('recv_host','IMAP-хост','imap.mail.ru');
        $f('recv_port','Порт','993');
        echo '<label style="color:#a0aec0;font-size:12px">Шифрование<br><select name="recv_encryption" style="width:100%;margin-top:4px">';
        foreach(['ssl'=>'SSL (993)','tls'=>'STARTTLS (143)'] as $v=>$l) echo '<option value="'.esc_attr($v).'"'.selected(($c['recv_encryption']??'ssl'),$v,false).'>'.esc_html($l).'</option>';
        echo '</select></label>';
        $f('recv_user','Логин','inbox@ваш.домен');
        $fp('recv_pass','Пароль');
        $f('recv_folder','Папка','INBOX');
        echo '</div>';

        echo '<h2 style="color:#00ff88;border-bottom:1px solid #2d3748;padding-bottom:8px;margin-top:24px">🛡 Анти-спам</h2>';
        echo '<textarea name="blacklist" rows="3" style="width:100%;margin-top:4px" placeholder="*@spam-domain.com&#10;newsletter@*">'.esc_textarea($c['blacklist']??'').'</textarea>';
        echo '<p style="color:#718096;font-size:11px">Rate-limit: 5 писем/час/адрес. Keyword-filter: автоматический. Blacklist: строки через Enter.</p>';

        echo '<div style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap">';
        echo '<button class="button button-primary">💾 Сохранить</button></form>';
        echo '<form method="post" action="'.esc_url(admin_url('admin-post.php')).'" style="display:inline"><input type="hidden" name="action" value="akpp_mail_test_send">'.wp_nonce_field('akpp_mail',false).'<button class="button">📨 Тест отправки</button></form>';
        echo '<form method="post" action="'.esc_url(admin_url('admin-post.php')).'" style="display:inline"><input type="hidden" name="action" value="akpp_mail_test_recv">'.wp_nonce_field('akpp_mail',false).'<button class="button">📥 Тест приёма</button></form>';
        echo '</div></div>';
    }
}
